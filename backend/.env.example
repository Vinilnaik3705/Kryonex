# Supabase Authentication
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
SUPABASE_JWT_AUDIENCE=authenticated

# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL (recommended for persistent production simulation state)
# DATABASE_URL=postgresql://username:password@localhost:5432/kryonex
# Supabase/Neon URLs are supported.

# Local fallback file used when PostgreSQL is unavailable.
SIMULATION_DATA_FILE=./data/simulation-state.json

# CORS Configuration
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://kryonex.vercel.app

# Groq AI Configuration
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=qwen/qwen3.8-27b

# Cache Configuration (in seconds)
CACHE_TTL_QUOTE=60
CACHE_TTL_HISTORY=300
CACHE_TTL_SEARCH=600

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Binance API Configuration (optional - for authenticated endpoints)
# BINANCE_API_KEY=your_binance_api_key_here
# BINANCE_API_SECRET=your_binance_api_secret_here
