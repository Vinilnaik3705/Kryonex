# Supabase Authentication
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
SUPABASE_JWT_AUDIENCE=authenticated

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://kryonex.vercel.app

# Persistent simulation storage
# Use MongoDB for multi-instance/production deployments.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/kryonex
# Local fallback file used only when MongoDB is unavailable.
SIMULATION_DATA_FILE=./data/simulation-state.json

# Groq AI Configuration
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-120b

# Cache Configuration (in seconds)
CACHE_TTL_QUOTE=60
CACHE_TTL_HISTORY=300
CACHE_TTL_SEARCH=600

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Binance API Configuration (optional - for authenticated endpoints)
# BINANCE_API_KEY=your_binance_api_key_here
# BINANCE_API_SECRET=your_binance_api_secret_here
